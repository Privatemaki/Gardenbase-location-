-- SCAN FRUITS
local function refreshFruits()
    fruitList = {}

    for _, farm in ipairs(workspace.Farm:GetChildren()) do

        local main = farm:FindFirstChild("Main")

        if main then

            local plants = main:FindFirstChild("Plant_Models")

            if plants then

                for _, fruit in ipairs(plants:GetChildren()) do

                    if not table.find(fruitList, fruit.Name) then
                        table.insert(fruitList, fruit.Name)
                    end

                end
            end
        end
    end
end

