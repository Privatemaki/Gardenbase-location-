-- 🔥 Instant Prompt (ADD ONLY - NO EDITS)

local promptConnections = {}

local function applyPrompt(obj)
   if obj:IsA("ProximityPrompt") then
      obj.HoldDuration = 0
      obj.RequiresLineOfSight = false
   end
end

local function enablePrompt()
   for _, obj in ipairs(game:GetDescendants()) do
      applyPrompt(obj)
   end

   table.insert(promptConnections,
      game.DescendantAdded:Connect(function(obj)
         applyPrompt(obj)
      end)
   )
end

local function disablePrompt()
   for _, c in ipairs(promptConnections) do
      c:Disconnect()
   end
   promptConnections = {}
end

PlayerTab:CreateToggle({
   Name = "Instant Prompt",
   CurrentValue = false,
   Flag = "InstantPromptToggle",
   Callback = function(Value)
      if Value then
         enablePrompt()
      else
         disablePrompt()
      end
   end,
})

